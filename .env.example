NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Exact HTTPS preview origin when using VS Code port forwarding; no wildcard.
SKILLSWAP_PUBLIC_ORIGIN=
# Enable only after custom SMTP and the signup code email template are saved.
EMAIL_OTP_ENABLED=false
# Optional; never publish on client
# Groq is the default. Keep a free Groq account to use its free allowance.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODELS=

# Optional relay for Study Circle calls on networks that block direct connections.
# Use a TURN server with REST credentials and keep its shared secret server-side.
STUDY_TURN_URLS=
STUDY_TURN_SECRET=
# OpenAI is used only when AI_PROVIDER=openai is explicitly selected.
OPENAI_API_KEY=
# Choose a Responses API model available to your OpenAI project.
OPENAI_MODEL=gpt-6-luna
# Optional comma-separated additional model IDs offered in Settings.
# Every model must support Responses structured outputs in your project.
OPENAI_MODELS=
# Enable only for development on your own computer without Supabase auth.
ALLOW_LOCAL_AI=false

# Optional scheduled study messages. Keep both credentials on the server.
SUPABASE_SERVICE_ROLE_KEY=
STUDY_NUDGE_SECRET=
# Set to email, whatsapp, or email,whatsapp after connecting each sender in n8n.
STUDY_NUDGE_CHANNELS=
